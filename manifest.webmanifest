{
  "name": "Habie — habit tracker",
  "short_name": "Habie",
  "description": "A playful habit tracker for iPad. Grow a garden of small habits.",
  "id": "./",
  "start_url": "./#home",
  "scope": "./",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#5a5fd0",
  "theme_color": "#7372c8",
  "categories": ["health", "lifestyle", "productivity"],
  "icons": [
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "docs/images/today.png", "sizes": "2360x1640", "type": "image/png", "form_factor": "wide", "label": "Today" },
    { "src": "docs/images/habits.png", "sizes": "2360x1640", "type": "image/png", "form_factor": "wide", "label": "Habits" }
  ],
  "shortcuts": [
    { "name": "New habit", "url": "./#new", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Insights", "url": "./#insights", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
